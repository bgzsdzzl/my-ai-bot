# GitHub App ID（数字）
APP_ID=
# .pem 私钥完整内容（含 BEGIN/END 行，双引号包裹并保留换行）
PRIVATE_KEY=
# 随机密钥：openssl rand -base64 32（或 node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"）
WEBHOOK_SECRET=
# Cloudflare Account ID
CF_ACCOUNT_ID=
# Cloudflare Workers AI Read 权限的 API Token
CF_API_TOKEN=
# Turso 数据库地址：libsql://xxx.turso.io
TURSO_URL=
# Turso Token
TURSO_TOKEN=
# 逗号分隔的 GitHub 用户名（全仓审查权限）
WHITELIST_USERS=
# GitHub App 名称，用于 @ 提及解析
BOT_NAME=
# 监听端口（可选，默认 3000）
PORT=3000
